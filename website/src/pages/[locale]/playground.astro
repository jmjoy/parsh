---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, url, type Locale } from '../../lib/site';
import '../../styles/playground.css';
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as Locale;
const zh = locale === 'zh-cn';
---
<SiteLayout locale={locale} title={zh ? '在线体验终端 — parsh' : 'Playground — parsh'} description={zh ? '在浏览器中运行真正的 parsh 与 coreutils，体验命令、文件、管道和控制流。' : 'Run parsh and coreutils in your browser. Try commands, files, pipes, and control flow.'} active="playground">
  <main id="main" class="playground-page" data-playground data-locale={locale}>
    <div class="playground-grid">
      <div class="playground-main">
        <section class="terminal-panel" aria-label={zh ? 'parsh 交互终端' : 'parsh interactive terminal'}>
          <div class="terminal-toolbar"><div class="terminal-identity"><span class="brand-symbol" aria-hidden="true">( )</span><span>parsh</span><span class="terminal-mode">{zh ? '命令会话' : 'COMMAND SESSION'}</span></div><div class="terminal-controls"><button data-clear disabled>{zh ? '清屏' : 'Clear'}</button><button data-interrupt disabled title="Ctrl+C">{zh ? '中断' : 'Interrupt'}</button><button data-reset>{zh ? '重置' : 'Reset'}<span aria-hidden="true">↻</span></button></div></div>
          <div class="terminal-body">
            <div class="terminal-host" data-terminal-host></div>
          </div>
          <div class="terminal-bottom"><span class="terminal-state" data-state="loading"><span class="status-dot"></span><span data-status role="status">{zh ? '正在加载运行环境…' : 'Loading the runtime…'}</span></span><span class="terminal-shortcuts"><kbd>Enter</kbd> {zh ? '求值' : 'evaluate'} <span>·</span> <kbd>Ctrl J</kbd> {zh ? '换行' : 'new line'}</span></div>
        </section>
        <div class="terminal-notice" data-notice hidden><span data-notice-text></span><button data-retry hidden>{zh ? '重试' : 'Retry'}</button></div>
        <p class="terminal-hint"><span aria-hidden="true">↳</span>{zh ? '提示符 $ () 已提供外层括号。输入 ' : 'The $ () prompt supplies the outer parentheses. Type '}<code>echo hello</code>{zh ? ' 并按 Enter，或粘贴完整表达式后按 Enter。' : ' and press Enter, or paste complete expressions and press Enter.'}</p>
        <noscript><p>{zh ? '交互终端需要 JavaScript。你仍然可以阅读完整文档。' : 'The terminal needs JavaScript. The full documentation is still available.'}</p></noscript>
      </div>
      <aside class="playground-sidebar" aria-label={zh ? '示例与帮助' : 'Examples and help'}>
        <div class="sidebar-section"><p class="eyebrow">{zh ? '试试这些' : 'TAKE IT FOR A SPIN'}</p><h2>{zh ? '从小例子开始。' : 'Start small.'}</h2><p class="sidebar-copy">{zh ? '选择示例，即可在当前会话中运行。' : 'Choose an example to run in this session.'}</p>
          <div class="example-list">
            <button class="example-button" data-example="commands" disabled><span><strong>{zh ? '运行 coreutils' : 'Run coreutils'}</strong><small>{zh ? '真实命令与 Unicode 输出' : 'Real commands and Unicode output'}</small></span><span aria-hidden="true">↗</span></button>
            <button class="example-button" data-example="pipeline" disabled><span><strong>{zh ? '连接一条管道' : 'Connect a pipeline'}</strong><small>{zh ? '排序并统计重复项' : 'Sort and count duplicates'}</small></span><span aria-hidden="true">↗</span></button>
            <button class="example-button" data-example="files" disabled><span><strong>{zh ? '读写临时文件' : 'Work with temporary files'}</strong><small>{zh ? '创建、追加与重定向' : 'Create, append, and redirect'}</small></span><span aria-hidden="true">↗</span></button>
            <button class="example-button" data-example="capture" disabled><span><strong>{zh ? '捕获命令输出' : 'Capture command output'}</strong><small>{zh ? '捕获输出并检查退出状态' : 'Capture output and inspect exit status'}</small></span><span aria-hidden="true">↗</span></button>

            <button class="example-button" data-example="hello" disabled><span><strong>{zh ? '你好，parsh' : 'Hello, parsh'}</strong><small>{zh ? '文本、列表与布尔值' : 'Text, lists, and booleans'}</small></span><span aria-hidden="true">↗</span></button>
            <button class="example-button" data-example="variables" disabled><span><strong>{zh ? '给一个值起名' : 'Give a value a name'}</strong><small>{zh ? '变量绑定与重新赋值' : 'Bindings and reassignment'}</small></span><span aria-hidden="true">↗</span></button>
            <button class="example-button" data-example="functions" disabled><span><strong>{zh ? '写一个小函数' : 'Write a small function'}</strong><small>{zh ? '参数与返回值' : 'Parameters and return values'}</small></span><span aria-hidden="true">↗</span></button>
            <button class="example-button" data-example="control" disabled><span><strong>{zh ? '做一个选择' : 'Make a choice'}</strong><small>{zh ? '条件、列表与循环' : 'Conditions, lists, and loops'}</small></span><span aria-hidden="true">↗</span></button>
          </div>
        </div>
        <div class="sidebar-section capability-note"><span class="note-symbol" aria-hidden="true">i</span><h3>{zh ? '命令、文件与管道。' : 'Commands, files, and pipes.'}</h3><p>{zh ? '这里运行 29 条真实 coreutils 命令，支持临时文件、管道与重定向。文件仅保留在当前会话中。' : 'Run 29 real coreutils commands with temporary files, pipes, and redirections. Files live only in this session.'}</p><a href={url(locale, 'docs/playground/')}>{zh ? '了解支持范围' : 'See what is supported'} <span aria-hidden="true">→</span></a></div>
        <div class="keyboard-guide"><h3>{zh ? '顺手的几个按键' : 'A few useful keys'}</h3><div><span>{zh ? '执行完整表达式' : 'Evaluate expression'}</span><kbd>Enter</kbd></div><div><span>{zh ? '按表达式移动' : 'Move by expression'}</span><kbd>Ctrl Alt F/B</kbd></div><div><span>{zh ? '吸入 / 吐出表达式' : 'Slurp / barf forward'}</span><kbd>Ctrl →/←</kbd></div><div><span>{zh ? '浏览历史' : 'Browse history'}</span><span><kbd>↑</kbd> <kbd>↓</kbd></span></div><div><span>{zh ? '清空输入 / 中断' : 'Cancel / interrupt'}</span><kbd>Ctrl C</kbd></div><div><span>{zh ? '空输入时退出' : 'Exit on empty input'}</span><kbd>Ctrl D</kbd></div></div>
      </aside>
    </div>
    <div class="playground-next"><p>{zh ? '准备在自己的文件上使用 parsh？' : 'Ready to use parsh with your own files?'}</p><a href={url(locale, 'docs/getting-started/')}>{zh ? '在 Linux 上开始使用 parsh' : 'Get started with parsh on Linux'} <span aria-hidden="true">→</span></a></div>
  </main>
</SiteLayout>
<script>
  import { mountTerminal } from '../../lib/terminal';
  const element = document.querySelector<HTMLElement>('[data-playground]');
  if (element) mountTerminal(element);
</script>
