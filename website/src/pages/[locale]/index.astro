---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, url, type Locale } from '../../lib/site';
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as Locale;
const zh = locale === 'zh-cn';
const features = zh ? [
  { number: '01', title: '命令与脚本，同一种语言。', text: '在提示符中试好的表达式，直接放进脚本。变量、函数与控制流，始终使用同一套规则。', code: '(defn greet ($name)\n  (str "hello, " $name))' },
  { number: '02', title: '参数，保持原来的样子。', text: '文本就是一个参数，列表显式展开。没有隐式分词、通配符展开，也不用猜测空格会发生什么。', code: '(let $files (list "a file.rs" "b.rs"))\n(list $files)' },
  { number: '03', title: '用结构，组合真正的命令。', text: 'Linux 上的程序直接启动。通过管道与重定向组合，保留熟悉的工具，换一种表达方式。', code: '(|> files.txt\n  (| (find . -name "*.rs") (sort)))' },
] : [
  { number: '01', title: 'One language. Both sides of the prompt.', text: 'Take an expression from your prompt straight into a script. The same variables, functions, and control flow, wherever you write.', code: '(defn greet ($name)\n  (str "hello, " $name))' },
  { number: '02', title: 'Arguments stay arguments.', text: 'Text stays one argument. Lists expand explicitly. No implicit word splitting or globbing, and no guessing what a space will do.', code: '(let $files (list "a file.rs" "b.rs"))\n(list $files)' },
  { number: '03', title: 'Real commands. Structured composition.', text: 'On Linux, programs launch directly. Compose them with pipes and redirections. Keep your tools; give them a different syntax.', code: '(|> files.txt\n  (| (find . -name "*.rs") (sort)))' },
];
---
<SiteLayout locale={locale} title={zh ? 'parsh — 把 Shell 放进括号里。' : 'parsh — Your shell, in parentheses.'} description={zh ? '一个命令行与脚本共用同一种 Lisp 方言的 Linux Shell。在线体验语法，阅读文档，开始使用 parsh。' : 'A Linux shell where the prompt and your scripts speak the same Lisp dialect. Try the language in your browser.'}>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span>PARENTHESIS SHELL <span class="eyebrow-divider">/</span> EARLY DAYS, OPEN SOURCE</div>
        <h1 id="hero-title">{zh ? <>你的 Shell，<br />换个<span class="accent">括号。</span></> : <>Your shell,<br />in <span class="accent">parentheses.</span></>}</h1>
        <p class="hero-description">{zh ? '命令行与脚本，共用一种小巧的 Lisp 方言。保留你熟悉的命令，让组合多一点结构。' : 'A small Lisp dialect for your command line and your scripts. Familiar commands, with a little more structure.'}</p>
        <div class="hero-actions"><a class="button button-primary" href={url(locale, 'playground/')}>{zh ? '在线体验语法' : 'Try the playground'}<span aria-hidden="true">↗</span></a><a class="button button-text" href={url(locale, 'docs/getting-started/')}>{zh ? '开始使用' : 'Get started'}<span aria-hidden="true">→</span></a></div>
        <p class="hero-footnote"><span aria-hidden="true">↳</span> {zh ? '浏览器中体验语法，Linux 上运行真正的命令。' : 'Explore the language in your browser. Run real commands on Linux.'}</p>
      </div>
      <div class="hero-art">
        <div class="bracket-art" aria-hidden="true"><span>(</span><span>)</span></div>
        <div class="demo-terminal">
          <div class="demo-titlebar"><div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div><span>parsh / a first conversation</span><span class="terminal-tag">SYNTAX PREVIEW</span></div>
          <div class="demo-code" role="group" aria-label={zh ? 'parsh 语法示例' : 'parsh syntax example'}>
            <div><span class="code-paren">(</span><span class="code-keyword">let</span> <span class="code-variable">$name</span> <span class="code-string">world</span>)</div>
            <div><span class="code-paren">(</span><span class="code-keyword">str</span> <span class="code-string">"hello, "</span> <span class="code-variable">$name</span>)</div>
            <div class="code-result">"hello, world"</div>
            <div class="code-gap"></div>
            <div><span class="code-paren">(</span><span class="code-keyword">defn</span> greet (<span class="code-variable">$who</span>)</div>
            <div>&nbsp; (<span class="code-keyword">str</span> <span class="code-string">"hello, "</span> <span class="code-variable">$who</span>))</div>
            <div><span class="code-paren">(</span>greet <span class="code-string">parsh</span>)</div>
            <div class="code-result">"hello, parsh"</div>
            <div class="code-gap"></div>
            <div class="demo-prompt"><span class="code-paren">(</span><span class="block-cursor" aria-hidden="true"></span></div>
          </div>
          <div class="demo-status"><span><span class="status-dot"></span> {zh ? '同一个 Rust 解释器' : 'The same Rust interpreter'}</span><span>UTF-8 · S-EXP</span></div>
        </div>
        <div class="art-note"><span aria-hidden="true">↖</span> {zh ? '闭合括号，即刻求值。' : 'Close the parenthesis. See what happens.'}</div>
      </div>
    </section>
    <div class="principles-strip"><span><i aria-hidden="true">∗</i>{zh ? 'S 表达式' : 'S-EXPRESSIONS'}</span><span><i aria-hidden="true">↗</i>{zh ? '显式的值' : 'EXPLICIT VALUES'}</span><span><i aria-hidden="true">⎇</i>{zh ? '可组合命令' : 'COMPOSABLE COMMANDS'}</span><span><i aria-hidden="true">⊙</i>{zh ? '使用 Rust 构建' : 'BUILT IN RUST'}</span></div>
    <section class="features-section" aria-labelledby="features-title">
      <div class="section-heading"><p class="eyebrow">SMALL LANGUAGE. FAMILIAR TERRITORY.</p><h2 id="features-title">{zh ? <>少一点猜测。<br />多一点结构。</> : <>Less guesswork.<br />More structure.</>}</h2><p>{zh ? 'parsh 意为 parenthesis shell。它把命令调用变成表达式，让交互探索和编写脚本自然衔接。' : 'parsh stands for parenthesis shell. It makes command calls expressions, so exploring at the prompt and writing a script feel like the same thing.'}</p></div>
      <div class="feature-grid">{features.map((feature) => <article class="feature-card"><span class="feature-number">/{feature.number}</span><h3>{feature.title}</h3><p>{feature.text}</p><pre><code>{feature.code}</code></pre>{feature.number === '03' && <span class="native-label">{zh ? 'Linux 原生环境' : 'NATIVE LINUX'}</span>}</article>)}</div>
    </section>
    <section class="start-panel" aria-labelledby="start-title"><div><p class="eyebrow">START WITH A PARENTHESIS.</p><h2 id="start-title">{zh ? <>从一个 <span>(</span> 开始。</> : <>It starts with <span>(</span></>}</h2><p>{zh ? '几行表达式，认识这门语言。无需安装，也无需离开浏览器。' : 'A few expressions are all it takes to get a feel for it. No installation. Just your browser.'}</p></div><a class="button button-dark" href={url(locale, 'playground/')}>{zh ? '打开体验终端' : 'Open the playground'}<span aria-hidden="true">↗</span></a></section>
  </main>
</SiteLayout>
