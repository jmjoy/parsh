---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, url, type Locale } from '../../lib/site';
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as Locale;
const zh = locale === 'zh-cn';
const features = zh ? [
  { number: '01', title: '命令行与脚本，同一种语言。', text: '在命令行中试好的表达式，可以直接放进脚本。变量、函数与控制流，始终遵循同一套规则。', code: '(defn greet (name)\n  (str "hello, " $name))' },
  { number: '02', title: '参数，保持完整。', text: '文本始终保持为一个参数，列表作为外部命令参数时展开一层。没有隐式分词或通配符展开，无需猜测空格会如何影响参数。', code: '(let files (list "a file.rs" "b.rs"))\n(list $files)' },
  { number: '03', title: '真实命令，结构化组合。', text: '在 Linux 上直接启动程序，用管道与重定向组合命令。保留熟悉的工具，用新的语法来表达。', code: '(|> files.txt\n  (| (find . -name "*.rs") (sort)))' },
] : [
  { number: '01', title: 'One language for the prompt and scripts.', text: 'Take an expression from the prompt straight into a script. Variables, functions, and control flow follow the same rules in both.', code: '(defn greet (name)\n  (str "hello, " $name))' },
  { number: '02', title: 'Arguments stay intact.', text: 'Text stays one argument. Lists expand one level into external command arguments. No implicit word splitting or globbing, and no guessing what spaces will do.', code: '(let files (list "a file.rs" "b.rs"))\n(list $files)' },
  { number: '03', title: 'Real commands. Structured composition.', text: 'On Linux, programs launch directly. Compose commands with pipes and redirections. Keep your familiar tools and use a new syntax.', code: '(|> files.txt\n  (| (find . -name "*.rs") (sort)))' },
];
---
<SiteLayout locale={locale} title={zh ? 'parsh — 把 Shell 放进括号里。' : 'parsh — Your shell, in parentheses.'} description={zh ? '一个命令行与脚本共用同一种 Lisp 方言的 Linux Shell。在浏览器中体验 parsh。' : 'A Linux shell whose command line and scripts use the same Lisp dialect. Try parsh in your browser.'}>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span>PARENTHESIS SHELL <span class="eyebrow-divider">/</span> {zh ? '早期开发，开源项目' : 'EARLY DEVELOPMENT, OPEN SOURCE'}</div>
        <h1 id="hero-title">{zh ? <>把 Shell<br />放进<span class="accent">括号里。</span></> : <>Your shell,<br />in <span class="accent">parentheses.</span></>}</h1>
        <p class="hero-description">{zh ? '命令行与脚本，共用一种小巧的 Lisp 方言。保留你熟悉的命令，让组合多一点结构。' : 'A small Lisp dialect for your command line and your scripts. Familiar commands, with a little more structure.'}</p>
        <div class="hero-actions"><a class="button button-primary" href={url(locale, 'playground/')}>{zh ? '在线体验' : 'Try the playground'}<span aria-hidden="true">↗</span></a><a class="button button-text" href={url(locale, 'docs/getting-started/')}>{zh ? '开始使用' : 'Get started'}<span aria-hidden="true">→</span></a></div>
        <p class="hero-footnote"><span aria-hidden="true">↳</span> {zh ? '浏览器中体验 parsh 与 coreutils，Linux 上处理自己的文件。' : 'Try parsh and coreutils in your browser. Work with your own files on Linux.'}</p>
      </div>
      <div class="hero-art">
        <div class="bracket-art" aria-hidden="true"><span>(</span><span>)</span></div>
        <div class="demo-terminal">
          <div class="demo-titlebar"><div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div><span>{zh ? 'parsh / 初识表达式' : 'parsh / first expressions'}</span><span class="terminal-tag">{zh ? '语法预览' : 'SYNTAX PREVIEW'}</span></div>
          <div class="demo-code" role="group" aria-label={zh ? 'parsh 语法示例' : 'parsh syntax example'}>
            <div><span class="code-paren">(</span><span class="code-keyword">let</span> <span class="code-variable">name</span> <span class="code-string">world</span>)</div>
            <div><span class="code-paren">(</span><span class="code-keyword">str</span> <span class="code-string">"hello, "</span> <span class="code-variable">$name</span>)</div>
            <div class="code-result">"hello, world"</div>
            <div class="code-gap"></div>
            <div><span class="code-paren">(</span><span class="code-keyword">defn</span> greet (<span class="code-variable">who</span>)</div>
            <div>&nbsp; (<span class="code-keyword">str</span> <span class="code-string">"hello, "</span> <span class="code-variable">$who</span>))</div>
            <div><span class="code-paren">(</span>greet <span class="code-string">parsh</span>)</div>
            <div class="code-result">"hello, parsh"</div>
            <div class="code-gap"></div>
            <div class="demo-prompt"><span class="code-paren">(</span><span class="block-cursor" aria-hidden="true"></span></div>
          </div>
          <div class="demo-status"><span><span class="status-dot"></span> {zh ? '同一个 Rust 解释器' : 'The same Rust interpreter'}</span><span>UTF-8 · S-EXP</span></div>
        </div>
        <div class="art-note"><span aria-hidden="true">↖</span> {zh ? '闭合括号，查看结果。' : 'Close the parenthesis. See the result.'}</div>
      </div>
    </section>
    <div class="principles-strip"><span><i aria-hidden="true">∗</i>{zh ? 'S 表达式' : 'S-EXPRESSIONS'}</span><span><i aria-hidden="true">↗</i>{zh ? '显式的值' : 'EXPLICIT VALUES'}</span><span><i aria-hidden="true">⎇</i>{zh ? '可组合命令' : 'COMPOSABLE COMMANDS'}</span><span><i aria-hidden="true">⊙</i>{zh ? '使用 Rust 构建' : 'BUILT IN RUST'}</span></div>
    <section class="features-section" aria-labelledby="features-title">
      <div class="section-heading"><p class="eyebrow">{zh ? '小巧的语言，熟悉的工具。' : 'SMALL LANGUAGE. FAMILIAR TOOLS.'}</p><h2 id="features-title">{zh ? <>少一点猜测。<br />多一点结构。</> : <>Less guesswork.<br />More structure.</>}</h2><p>{zh ? 'parsh 意为 parenthesis shell。命令调用就是表达式，命令行交互与脚本编写共用同一种语言。' : 'parsh stands for parenthesis shell. Command calls are expressions, and interactive use and scripts share one language.'}</p></div>
      <div class="feature-grid">{features.map((feature) => <article class="feature-card"><span class="feature-number">/{feature.number}</span><h3>{feature.title}</h3><p>{feature.text}</p><pre><code>{feature.code}</code></pre>{feature.number === '03' && <span class="native-label">{zh ? 'Linux 原生环境' : 'NATIVE LINUX'}</span>}</article>)}</div>
      <aside class="agent-band" aria-labelledby="agent-title">
        <div class="agent-copy">
          <p class="eyebrow">{zh ? '写给人，也写给 AI。' : 'FOR PEOPLE AND FOR AGENTS.'}</p>
          <h3 id="agent-title">{zh ? '逻辑和命令，一套语法。' : 'Logic and commands, one grammar.'}</h3>
          <p>{zh ? '算术、数据与控制流留在脚本里，程序、管道与重定向同样是表达式。少一层需要猜的引号，生成的脚本读起来就是它执行的样子。' : 'Arithmetic, data, and control flow stay in the script; programs, pipes, and redirections are expressions too. With fewer quoting layers to guess, generated scripts read the way they run.'}</p>
        </div>
        <pre><code>(let count (+ (| (ls) (wc -l)) 0))
(echo "entries: $count; doubled: $(* $count 2)")</code></pre>
      </aside>
    </section>
    <section class="start-panel" aria-labelledby="start-title"><div><p class="eyebrow">{zh ? '从括号开始。' : 'START WITH A PARENTHESIS.'}</p><h2 id="start-title">{zh ? <>从一个 <span>(</span> 开始。</> : <>Start with <span>(</span></>}</h2><p>{zh ? '几行表达式，认识这门语言。无需安装，也无需离开浏览器。' : 'A few expressions are all it takes to get a feel for the language. No installation. Just your browser.'}</p></div><a class="button button-dark" href={url(locale, 'playground/')}>{zh ? '打开体验终端' : 'Open the playground'}<span aria-hidden="true">↗</span></a></section>
  </main>
</SiteLayout>
