#!/usr/bin/env parsh
(; Run with: cargo run -- examples/pipelines.parsh )

(export LC_ALL C)
(let fruits (list pear apple pear banana apple))
(echo "sorted counts:")
(| (printf "%s\n" $fruits)
   (sort)
   (uniq -c))

(; Explicitly capture pipeline stdout and keep it as one argument. )
(let unique
  (<-out (fn ()
    (| (printf "%s\n" $fruits)
       (sort)
       (uniq)))))
(printf "captured as one argument:\n<%s>\n" $unique)

(; Convert the numeric text produced by an external command before arithmetic. )
(let lines
  (int (<-out (fn ()
    (| (printf "%s\n" $fruits) (wc -l))))))
(echo "lines=$lines double=$(* $lines #2)")
