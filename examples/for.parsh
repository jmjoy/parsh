#!/usr/bin/env parsh
(; Run with: cargo run -- examples/for.parsh )

(let completed 0)
(let item outer)
(for item (list first skip third stop unreachable)
  (if (eq $item skip) (continue))
  (if (eq $item stop) (break))
  (set completed (+ $completed 1))
  (printf "processing %s\n" $item))
(printf "completed=%s outer binding=%s\n" $completed $item)

(; An inner break ends its own loop; the outer loop keeps running. )
(for row (list A B)
  (for column (list 1 2 3)
    (if (= $column 3) (break))
    (echo "$row$column")))
