#!/usr/bin/env parsh
(; Run with: cargo run -- examples/macros.parsh )

(; A macro receives its arguments as quoted forms and returns a form to run. )
(defmacro unless (condition body)
  `(if (not ,$condition) ,$body))
(unless #false (echo "unless ran"))

(defmacro when (condition body)
  `(if ,$condition ,$body))
(when #true (echo "when ran"))

(; Unquote-splicing flattens a list form into the surrounding call. )
(defmacro begin (body)
  `(do ,@$body))
(begin ((echo one) (echo two)))

(; Optional macro parameters run their defaults during expansion, while rest
   collects the remaining forms for unquote-splicing. )
(defmacro when-labeled
  (condition &optional (label (quote "when-labeled")) &rest body)
  `(if ,$condition
       (do (echo ,$label) ,@$body)))
(when-labeled #true)
(when-labeled #true custom (echo three) (echo four))

(; Expansion happens in the caller scope, so templates can refer to it. )
(defmacro greet (who)
  `(echo hello ,$who))
(let who "parsh")
(greet $who)

(; Quotes are ordinary values: they print as source and compare by syntax. )
(if (eq (quote (a b)) (quote (a b)))
    (echo "forms compare by syntax"))
(type unless)
