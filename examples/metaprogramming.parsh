#!/usr/bin/env parsh
(; Run with: cargo run -- examples/metaprogramming.parsh )

(; These macros are available in every new session. )
(when #true (dump enabled))
(unless #false (dump available))
(dump (cond ((< #3 #2) small) ((= #3 #3) equal) (else other)))
(dump (-> {http {retries #2}} (map/get-in [http retries]) (+ #1)))
(dump (->> [#1 #2 #3 #4] (list/filter even?) (list/map (partial + #10))))
(dump (macroexpand-1 (quote (-> #1 (+ #2) (* #3)))))

(; Reading creates syntax; eval runs a form in the caller scope. )
(let amount #5)
(let code (read '(+ $amount #2)'))
(dump (list (form/kind $code) (form/source $code)))
(dump (list/map (function form/kind) (form/children $code)))
(dump (form/value (quote #7)))
(dump (eval $code))
(dump (eval (form/list [(form/word +) (form/from-value #2) (form/from-value #3)])))
(let data {literal '$amount' nested [#nil #true]})
(dump (eq $data (eval (form/from-value $data))))

(; Generated identifiers preserve identity through construction and expansion. )
(defmacro twice (expression)
  (let temporary (gensym temporary))
  (let reference (form/variable $temporary))
  `(do (let ,$temporary ,$expression) (+ ,$reference ,$reference)))
(let calls #0)
(dump (twice (do (set calls (+ $calls #1)) #3)))
(dump (list $calls (eq (gensym) (gensym))))
