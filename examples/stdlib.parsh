#!/usr/bin/env parsh
(; Run with: cargo run -- examples/stdlib.parsh )

(; List updates return new values and preserve nested lists. )
(let names (str/split "Ada,Grace,Linus" ","))
(let extended (list/append $names "Margaret Hamilton"))
(echo "original=$(str/join $names ', ')")
(echo "extended=$(str/join $extended ', ')")
(echo "last=$(list/get $extended #-1); middle=$(str/join (list/slice $extended #1 #-1) ', ')")
(dump (list/append [a b] [c d]))

(; Text indexing counts Unicode scalar values; split and join require text. )
(echo "Unicode characters: $(str/len '中文'); slice=$(str/slice '中文abc' #1 #3)")
(dump (str/lines "first\r\nsecond\n"))
(echo (str/replace (str/trim "  hello, parsh  ") parsh world))

(; Higher-order functions accept callbacks and preserve value types. )
(let numbers [#1 #2 #3 #4])
(let doubled (list/map (fn (n) (* $n #2)) $numbers))
(dump $doubled)
(dump (list/filter (fn (n) (> $n #4)) $doubled))
(echo "sum=$(list/fold (function +) #0 $numbers)")
(echo "any above three=$(list/any (fn (n) (> $n #3)) $numbers)")
(echo "all positive=$(list/all (fn (n) (> $n #0)) $numbers)")
(dump (list/reverse $numbers))
(echo "contains three=$(list/contains $numbers #3)")

(echo "quot=$(quot #-7 #3); rem=$(rem #-7 #3); rounded=$(round #-2.5)")
(echo "min=$(min #3 #1.5 #2); abs=$(abs #-7); empty=$(empty? [])")
