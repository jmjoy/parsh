#!/usr/bin/env parsh
(; Run with: cargo run -- examples/stdlib.parsh )

(let names (str/split "Ada,Grace,Linus" ","))
(let extended (list/append $names "Margaret Hamilton"))
(echo "original=$(str/join $names ', ')")
(echo "extended=$(str/join $extended ', ')")
(echo "last=$(list/get $extended #-1); middle=$(str/join (list/slice $extended #1 #-1) ', ')")
(echo "Unicode characters: $(str/len '中文')")

(defn accumulator (initial)
  (fn (&optional (step #1) &rest more)
    (set initial (+ $initial $step))
    (for amount $more (set initial (+ $initial $amount)))
    (return $initial)))
(let next (accumulator #10))
(echo ($next) ($next #2 #3) (apply $next []))
(echo "sum=$(apply (function +) #1 [#2 #3]); quot=$(quot #-7 #3); rem=$(rem #-7 #3)")

(defmacro when (condition &rest body)
  `(if ,$condition (do ,@$body)))
(when (and (number? ($next)) (not (empty? $names)))
  (echo "functions and lists compose")
  (echo "rounded=$(round #-2.5)"))
